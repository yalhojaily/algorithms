---
// One stage of a section's learning path. The section page builds its path navigation from these.
interface Props { n: number; id: string; title: string; sub?: string }
const { n, id, title, sub } = Astro.props;
---
<section class="stage" id={id}>
  <header class="stage-head">
    <span class="stage-n">{n}</span>
    <div>
      <h2 class="stage-title">{title}</h2>
      {sub && <p class="stage-sub">{sub}</p>}
    </div>
  </header>
  <div class="stage-body"><slot /></div>
</section>
<style>
  .stage { margin-top: 44px; scroll-margin-top: 120px; }
  .stage:first-child { margin-top: 12px; }
  .stage-head { display: flex; gap: 14px; align-items: center; padding: 10px 0; border-bottom: 2px solid var(--line); margin-bottom: 8px; }
  .stage-n { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--brand); color: #fff; font: 700 1.1rem/1 var(--font-num); }
  .stage-title { margin: 0; font-size: 1.45rem; border: 0; padding: 0; }
  .stage-sub { margin: 0; color: var(--ink-3); font-size: 0.92rem; line-height: 1.5; }
</style>
