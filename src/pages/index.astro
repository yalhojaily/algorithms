---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourseMap from '../components/CourseMap.tsx';
import { allLessons, curriculum, lessonById, lessonHref, phaseHref, refs, rhythm } from '../data/curriculum';

const base = import.meta.env.BASE_URL;
const entries = await getCollection('lessons');
const available = Object.fromEntries(entries.map((e) => [e.data.id, lessonHref(base, lessonById(e.data.id)!)]));
const phaseLinks = Object.fromEntries(curriculum.map((p) => [p.key, phaseHref(base, p)]));
const first = allLessons.find((l) => available[l.id])!;

const refList = [
  { ...refs.ocw6006, role: 'العمود الفقري للمراحل 1–4: محاضرات وملاحظات وواجبات بحلولها.' },
  { ...refs.ocw6046, role: 'للمرحلتين 3 و5: التصميم المتقدم والعشوائية والتقريب.' },
  { ...refs.jeffe, role: 'كتاب مجاني ممتاز لاستراتيجيات التصميم، ومسائله كثيرة.' },
  { ...refs.mcs, role: 'كتاب مجاني يغطي المرحلة 0 كاملة، ومعها الاحتمالات.' },
  { ...refs.bop, role: 'كتاب مجاني في المنطق وأساليب البرهان.' },
  { ...refs.ods, role: 'كتاب مجاني لهياكل البيانات، للمرحلة 2.' },
  { ...refs.tim, role: 'شرح مرئي واضح جدًا، مرجع ثانٍ حين يصعب موضوع.' },
];
---

<Base title="الخوارزميات · رحلة الأشهر الستة">
  <div class="container"><a class="book-banner card" href={`${base}book/`}>
    <span class="bb-tag">جديد · تجربة</span>
    <span class="bb-t">مسار الكتاب: <span class="ltr">Algorithms</span> لـ Jeff Erickson، قسمًا قسمًا</span>
    <span class="bb-s">صفحات الكتاب نفسها، ثم شرح عربي موسّع ومحاكاة وتمارين الكتاب. الفصلان 0 و1 جاهزان.</span>
    <span class="bb-go">ادخل ←</span>
  </a></div>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <div class="hero-kicker">6 مراحل · <span class="ltr">{allLessons.length}</span> درسًا · 26 أسبوعًا</div>
        <h1>ادرس الخوارزميات <em>كما تُدرَّس</em> في الجامعة.</h1>
        <p class="hero-lede">
          من المنطق والاستقراء إلى NP-Completeness. كل درس مبني على مراجع جامعية مجانية، وفيه محاكاة تشغّلها خطوة بخطوة، وبراهين، وتمارين بحلول مخفية، ومختبر برمجي تقيس فيه زمن كودك بنفسك.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={available[first.id]}>ابدأ بالدرس {first.id}: {first.title} ←</a>
          <a class="btn" href="#map">خريطة الرحلة</a>
        </div>
      </div>
      <ol class="rhythm" aria-label="أقسام كل درس">
        {rhythm.map(([name, desc]) => <li><b>{name}</b> {desc}</li>)}
      </ol>
    </div>
  </section>

  <section class="container" id="map">
    <h2 class="map-title">خريطة الرحلة</h2>
    <CourseMap client:load phases={curriculum} available={available} phaseLinks={phaseLinks} />
  </section>

  <section class="container" id="refs">
    <h2>المراجع المجانية</h2>
    <div class="ref-grid">
      {refList.map((r) => (
        <a class="ref card" href={r.url} target="_blank" rel="noopener">
          <span class="ref-name ltr">{r.name}</span>
          <span class="ref-by ltr">{r.by}</span>
          <span class="ref-role">{r.role}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .book-banner { display: grid; grid-template-columns: auto 1fr auto; gap: 2px 14px; align-items: center; margin-top: 18px; padding: 14px 18px; text-decoration: none; color: var(--ink); border-color: color-mix(in srgb, var(--brand) 45%, var(--line)); background: linear-gradient(90deg, var(--brand-soft), var(--card) 60%); }
  .book-banner:hover { border-color: var(--brand); }
  .bb-tag { grid-row: span 2; font-size: 0.75rem; font-weight: 700; color: #fff; background: var(--brand); border-radius: 99px; padding: 3px 10px; }
  .bb-t { font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; }
  .bb-s { font-size: 0.86rem; color: var(--ink-2); grid-column: 2; }
  .bb-go { grid-row: 1 / span 2; grid-column: 3; font-weight: 700; color: var(--brand); }
  @media (max-width: 600px) { .book-banner { grid-template-columns: 1fr; } .bb-tag { grid-row: auto; justify-self: start; } .bb-s, .bb-go { grid-column: 1; grid-row: auto; } }
  .hero { padding: 60px 0 46px; background: linear-gradient(180deg, var(--olive-soft), transparent); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .hero-kicker { color: var(--brand); font-weight: 700; font-size: 0.9rem; }
  .hero h1 { font-size: clamp(2rem, 5.4vw, 3.1rem); margin: 0.25em 0 0.35em; }
  .hero h1 em { font-style: normal; color: var(--brand); }
  .hero-lede { font-size: 1.1rem; color: var(--ink-2); max-width: 38em; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .rhythm { list-style: none; counter-reset: r; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .rhythm li { counter-increment: r; display: grid; grid-template-columns: 30px 1fr; column-gap: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 7px 14px; font-size: 0.9rem; color: var(--ink-2); box-shadow: var(--shadow); line-height: 1.6; }
  .rhythm li::before { content: counter(r); grid-row: span 2; width: 26px; height: 26px; border-radius: 50%; background: var(--brand); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 0.82rem; align-self: center; font-family: var(--font-num); }
  .rhythm b { color: var(--ink); }
  .map-title { margin-top: 1.2em; }
  .ref-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .ref { display: flex; flex-direction: column; gap: 2px; padding: 16px 18px; text-decoration: none; color: var(--ink); transition: border-color 0.15s; }
  .ref:hover { border-color: var(--brand); }
  .ref-name { font-family: var(--font-num); font-size: 1.05rem; }
  .ref-name { font-weight: 700; text-align: right; }
  .ref-by { font-size: 0.82rem; color: var(--ink-3); text-align: right; }
  .ref-role { font-size: 0.9rem; color: var(--ink-2); margin-top: 6px; }
  @media (max-width: 860px) { .hero-inner { grid-template-columns: 1fr; gap: 28px; } }
</style>