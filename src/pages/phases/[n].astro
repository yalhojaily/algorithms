---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { curriculum, lessonHref, phaseLabel, type Phase } from '../../data/curriculum';

export function getStaticPaths() {
  return curriculum.map((p) => ({ params: { n: p.key }, props: { phase: p } }));
}

const { phase } = Astro.props as { phase: Phase };
const base = import.meta.env.BASE_URL;
const available = new Set((await getCollection('lessons')).map((e) => e.data.id));
const weeks: number[] = [];
for (let w = phase.weeks[0]; w <= phase.weeks[1]; w++) weeks.push(w);
const idx = curriculum.indexOf(phase);
const prev = curriculum[idx - 1];
const next = curriculum[idx + 1];
---

<Base title={`${phaseLabel(phase)}: ${phase.title} · الخوارزميات`} description={phase.goal}>
  <div class="container phase">
    <div class="phase-kicker"><span class="phase-num">{phase.number}</span> {phaseLabel(phase)} · الأسابيع <span class="ltr">{phase.weeks[0]}–{phase.weeks[1]}</span></div>
    <h1>{phase.title} <span class="en">{phase.en}</span></h1>
    <p class="phase-goal">{phase.goal}</p>

    <div class="phase-grid">
      <div>
        {weeks.map((w) => (
          <section class="week card">
            <header class="week-head">الأسبوع <span class="ltr">{w}</span></header>
            <ol class="week-lessons">
              {phase.lessons.filter((l) => l.week === w).map((l) => (
                <li class={available.has(l.id) ? '' : 'soon'}>
                  {available.has(l.id) ? (
                    <a href={lessonHref(base, l)}><span class="wl-id">{l.id}</span><span class="wl-t">{l.title}</span><span class="en">{l.en}</span>{l.lab && <span class="tag teal">مختبر</span>}</a>
                  ) : (
                    <span><span class="wl-id">{l.id}</span><span class="wl-t">{l.title}</span><span class="en">{l.en}</span><span class="tag">قريبًا</span></span>
                  )}
                </li>
              ))}
            </ol>
            <div class="week-ps">📝 واجب الأسبوع <span class="ltr">{w}</span> <span class="tag">قريبًا</span></div>
          </section>
        ))}
      </div>
      <aside class="phase-side card">
        <div class="side-label">مراجع المرحلة</div>
        <ul class="phase-refs">
          {phase.refs.map((r) => <li><a href={r.url} target="_blank" rel="noopener" class="ltr">{r.name}</a><div class="ltr ref-by">{r.by}</div></li>)}
        </ul>
      </aside>
    </div>

    <nav class="phase-pager">
      {prev ? <a class="btn" href={`${base.replace(/\/$/, '')}/phases/${prev.key}/`}>→ {phaseLabel(prev)}: {prev.title}</a> : <span />}
      {next && <a class="btn" href={`${base.replace(/\/$/, '')}/phases/${next.key}/`}>{phaseLabel(next)}: {next.title} ←</a>}
    </nav>
  </div>
</Base>

<style>
  .phase { padding-top: 34px; }
  .phase-kicker { color: var(--ink-3); font-weight: 600; display: flex; align-items: center; gap: 10px; }
  .phase-num { font-family: var(--font-mono); font-weight: 700; background: var(--teal); color: #fff; border-radius: 10px; padding: 0 12px; font-size: 1.3rem; }
  .phase h1 .en { font-size: 0.5em; margin-inline-start: 8px; }
  .phase-goal { font-size: 1.1rem; color: var(--ink-2); max-width: 46em; }
  .phase-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 28px; margin-top: 24px; align-items: start; }
  .week { padding: 14px 18px; margin-bottom: 14px; }
  .week-head { font-family: var(--font-head); font-weight: 700; color: var(--teal); margin-bottom: 6px; }
  .week-lessons { list-style: none; margin: 0; padding: 0; }
  .week-lessons a, .week-lessons li > span { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; padding: 7px 8px; border-radius: 9px; text-decoration: none; color: var(--ink); }
  .week-lessons a:hover { background: var(--teal-soft); }
  .week-lessons li.soon > span { color: var(--ink-3); }
  .wl-id { font-family: var(--font-mono); color: var(--teal); font-weight: 700; min-width: 34px; }
  .soon .wl-id { color: var(--ink-3); }
  .wl-t { font-weight: 600; }
  .week-ps { margin-top: 6px; padding-top: 8px; border-top: 1px dashed var(--line); color: var(--ink-3); font-size: 0.9rem; }
  .phase-side { padding: 16px 18px; position: sticky; top: 84px; }
  .side-label { font-size: 0.8rem; font-weight: 700; color: var(--ink-3); margin-bottom: 6px; }
  .phase-refs { list-style: none; margin: 0; padding: 0; }
  .phase-refs li { padding: 6px 0; border-bottom: 1px solid var(--line); text-align: right; }
  .phase-refs li:last-child { border-bottom: none; }
  .phase-refs a { font-weight: 600; text-decoration: none; display: block; text-align: right; }
  .ref-by { font-size: 0.8rem; color: var(--ink-3); text-align: right; }
  .phase-pager { display: flex; justify-content: space-between; gap: 12px; margin-top: 36px; flex-wrap: wrap; }
  @media (max-width: 860px) { .phase-grid { grid-template-columns: 1fr; } .phase-side { position: static; } }
</style>
